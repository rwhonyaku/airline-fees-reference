{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airline-fees.com/schemas/provenance.schema.json",
  "title": "Versioned airline policy provenance dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "subject", "source_hierarchy", "sources", "claims"],
  "properties": {
    "schema_version": { "const": "0.1.0-pilot" },
    "dataset_id": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "slug", "name"],
      "properties": {
        "type": { "const": "airline" },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "source_hierarchy": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "type", "label"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1 },
          "type": { "$ref": "#/$defs/sourceType" },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/claim" }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "nullableDate": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
    "sourceType": {
      "type": "string",
      "enum": ["airline_policy_page", "airline_conditions_or_tariff", "airline_booking_or_calculator", "airline_help_center", "other_official_airline_publication"]
    },
    "verificationStatus": {
      "type": "string",
      "enum": ["verified", "needs_recheck", "source_changed", "potential_change_detected", "unable_to_verify"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "type", "hierarchy_rank", "publisher", "title", "url", "locale", "accessed_at", "monitoring"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^src\\.[a-z0-9.-]+$" },
        "type": { "$ref": "#/$defs/sourceType" },
        "hierarchy_rank": { "type": "integer", "minimum": 1, "maximum": 5 },
        "publisher": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "locale": { "type": "string", "minLength": 2 },
        "accessed_at": { "$ref": "#/$defs/date" },
        "monitoring": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy_regions"],
          "properties": {
            "policy_regions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["region_id", "start_marker", "end_marker", "claim_ids"],
                "properties": {
                  "region_id": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
                  "start_marker": { "type": "string", "minLength": 10 },
                  "end_marker": { "type": "string", "minLength": 10 },
                  "claim_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operating_carriers", "marketing_carriers", "cabins", "fare_families", "markets", "routes", "passenger_types", "purchase_channels"],
      "properties": {
        "operating_carriers": { "type": "array", "items": { "type": "string" } },
        "marketing_carriers": { "type": "array", "items": { "type": "string" } },
        "cabins": { "type": "array", "items": { "type": "string" } },
        "fare_families": { "type": "array", "items": { "type": "string" } },
        "markets": { "type": "array", "items": { "type": "string" } },
        "routes": { "type": "array", "items": { "type": "string" } },
        "passenger_types": { "type": "array", "items": { "type": "string" } },
        "purchase_channels": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "supports"],
      "properties": {
        "source_id": { "type": "string" },
        "supports": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "source_locator": { "type": "string" }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision_id", "assertion", "scope", "evidence", "verification", "validity", "change"],
      "properties": {
        "revision_id": { "type": "string", "pattern": "^rev\\.[a-z0-9.-]+$" },
        "assertion": { "type": "object", "minProperties": 2 },
        "scope": { "$ref": "#/$defs/scope" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "detected_at", "checked_at", "verified_at", "reviewed_by"],
          "properties": {
            "status": { "$ref": "#/$defs/verificationStatus" },
            "detected_at": { "$ref": "#/$defs/date" },
            "checked_at": { "$ref": "#/$defs/date" },
            "verified_at": { "$ref": "#/$defs/nullableDate" },
            "reviewed_by": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "identifier"],
              "properties": {
                "type": { "type": "string", "enum": ["human", "automation"] },
                "identifier": { "type": "string", "minLength": 1 }
              }
            },
            "notes": { "type": "string" }
          }
        },
        "validity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["effective_from", "effective_to", "effective_date_status"],
          "properties": {
            "effective_from": { "$ref": "#/$defs/nullableDate" },
            "effective_to": { "$ref": "#/$defs/nullableDate" },
            "effective_date_status": { "type": "string", "enum": ["published", "not_published", "unknown"] }
          }
        },
        "change": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "supersedes_revision_id", "summary"],
          "properties": {
            "kind": { "type": "string", "enum": ["initial", "policy_change", "correction", "scope_clarification", "source_refresh"] },
            "supersedes_revision_id": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
            "summary": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "subject", "category", "fact_type", "review_cadence", "revisions"],
      "properties": {
        "claim_id": { "type": "string", "pattern": "^air-france\\.[a-z0-9.-]+$" },
        "subject": { "const": "air-france" },
        "category": { "type": "string", "minLength": 1 },
        "fact_type": { "type": "string", "minLength": 1 },
        "review_cadence": { "type": "string", "enum": ["monthly", "quarterly", "semiannual", "annual", "event_driven"] },
        "revisions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/revision" } }
      }
    }
  }
}
