{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airline-fees.com/schemas/airline.schema.json",
  "title": "Airline policy record",
  "type": "object",
  "additionalProperties": true,
  "required": ["slug", "name", "fees"],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Stable URL slug used at /airlines/[slug]."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "iata": {
      "type": "string",
      "minLength": 2,
      "maxLength": 3
    },
    "icao": {
      "type": "string",
      "minLength": 3,
      "maxLength": 4
    },
    "country": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional record-level quality metadata for the gold-standard data program.",
      "properties": {
        "tier": {
          "type": "string",
          "enum": ["gold", "silver", "bronze", "stub"]
        },
        "last_full_review": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "next_review_due": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "owner_note": {
          "type": "string"
        }
      }
    },
    "unique_insights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "traps": {
          "type": "array",
          "items": { "type": "string" }
        },
        "pro_hack": {
          "type": "string"
        }
      }
    },
    "fees": {
      "type": "array",
      "items": {
        "$ref": "fee.schema.json"
      }
    },
    "policy_change_history": {
      "type": "array",
      "description": "Optional historical policy-change records. Start capturing now even before the public UI exposes history.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "summary", "source_url", "verified_date"],
        "properties": {
          "category": { "type": "string" },
          "previous_value": { "type": "string" },
          "new_value": { "type": "string" },
          "effective_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "verified_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "summary": {
            "type": "string"
          }
        }
      }
    }
  }
}
